          float bumpR = texture2D(bumpTexture, vUv + vec2(texelSize.x, 0.0)).r;
          float bumpU = texture2D(bumpTexture, vUv + vec2(0.0, texelSize.y)).r;
          float bumpD = texture2D(bumpTexture, vUv + vec2(0.0, -texelSize.y)).r;
          vec3 perturbedNormal = normalize(vNormal + vec3(
            (bumpL - bumpR) * bumpScale,
            (bumpD - bumpU) * bumpScale,
            0.0
          ));

          // Giorno/notte col terminatore morbido (come wueform)
          float diffuse = dot(perturbedNormal, vLightDir);
          float dayMix = smoothstep(-0.15, 0.25, diffuse);
          vec3 color = mix(nightColor.rgb, giorno, dayMix);

          // Luci di citt\xE0 sul lato notte (come wueform)
          float nightLightIntensity = max(nightColor.r, max(nightColor.g, nightColor.b));
