<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>BarTalk — il programma completo con i miglioramenti (solo grafica)</title>
<style>
/* ═════════ DESIGN INVARIATO: colori, sfondi, campi = quelli dell'app ═════════ */
:root{
  --bg:#070b16; --bg2:#0a0f1f; --card:#10183099; --card2:#101830; --bordo:#233052;
  --testo:#eef2ff; --muto:#8a94b8; --acc:#5b8cff; --acc2:#38d4f5;
  --grad:linear-gradient(90deg,#5b8cff,#38d4f5);
  --verde:#34d399; --oro:#fbbf24; --rosso:#f87171;
  --r:16px; --font:-apple-system,'SF Pro Text','Segoe UI',Roboto,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%;background:var(--bg);color:var(--testo);font-family:var(--font)}
body{overflow:hidden}
button{font-family:var(--font);cursor:pointer;border:none;color:inherit;background:none}
input,textarea,select{font-family:var(--font)}
.stelle{position:fixed;inset:0;pointer-events:none;z-index:0;
  background-image:radial-gradient(1px 1px at 20% 30%,#ffffff55 50%,transparent 50%),
  radial-gradient(1px 1px at 70% 15%,#ffffff44 50%,transparent 50%),
  radial-gradient(1.5px 1.5px at 45% 60%,#ffffff33 50%,transparent 50%),
  radial-gradient(1px 1px at 85% 75%,#ffffff55 50%,transparent 50%),
  radial-gradient(1px 1px at 10% 85%,#ffffff33 50%,transparent 50%),
  radial-gradient(1.5px 1.5px at 60% 90%,#ffffff44 50%,transparent 50%)}

/* ═════════ SCHERMATE ═════════ */
.schermo{position:fixed;inset:0;display:none;overflow-y:auto;z-index:1}
.schermo.on{display:block}
#s-community{overflow:hidden}
.tel{max-width:520px;margin:0 auto;padding:0 16px 130px;position:relative;min-height:100%}

/* ═════════ GRAMMATICA (una sola forma per ogni cosa) — schermate app ═════════ */
.app-testa{display:flex;align-items:center;gap:10px;padding:16px 0 12px;position:sticky;top:0;z-index:50;
  background:linear-gradient(var(--bg) 75%,transparent)}
.tq{width:40px;height:40px;border-radius:13px;background:#141c33;border:1px solid var(--bordo);
  display:grid;place-items:center;font-size:16px;flex:none;transition:.15s}
.tq:active{transform:scale(.92)}
.app-testa h1{font-size:21px;font-weight:900;flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.app-testa h1 small{display:block;font-size:11px;color:var(--muto);font-weight:600}
.stato{display:flex;align-items:center;gap:6px;background:#141c33;border:1px solid var(--bordo);
  border-radius:99px;padding:8px 13px;font-size:12.5px;font-weight:800;flex:none;transition:.15s}
.stato:active{transform:scale(.96)}
.stato .sep{width:1px;height:12px;background:var(--bordo)}
.stato .rosso{color:var(--rosso)}
.campo{width:100%;padding:16px;border-radius:14px;border:1px solid var(--bordo);background:#0d1425;
  color:var(--testo);font-size:16px;outline:none;transition:border .2s}
.campo:focus{border-color:var(--acc)}
.campo::placeholder{color:#5b6688}
textarea.campo{min-height:96px;resize:vertical}
.etic{font-size:11.5px;letter-spacing:.7px;text-transform:uppercase;color:var(--muto);
  font-weight:800;margin:18px 0 8px;display:block}
.seg{display:flex;background:#0d1425;border:1px solid var(--bordo);border-radius:12px;padding:3px;gap:3px}
.seg button{flex:1;padding:10px 6px;border-radius:9px;font-size:12.5px;font-weight:800;color:var(--muto);transition:.18s;white-space:nowrap}
.seg button.on{background:var(--grad);color:#04121c}
.pillr{display:flex;gap:8px;overflow-x:auto;padding:4px 0;scrollbar-width:none}
.pillr::-webkit-scrollbar{display:none}
.pill{white-space:nowrap;padding:9px 15px;border-radius:99px;background:#121a30;border:1px solid var(--bordo);
  color:var(--muto);font-size:13px;font-weight:700;transition:.15s;flex:none;cursor:pointer}
.pill.on{background:#dbeafe22;color:var(--acc2);border-color:var(--acc)}
.ctaFissa{position:sticky;bottom:0;z-index:20;padding:14px 0 10px;
  background:linear-gradient(transparent,var(--bg) 45%)}
.cta{width:100%;padding:17px;border-radius:16px;background:var(--grad);color:#04121c;
  font-weight:900;font-size:16px;box-shadow:0 8px 28px #5b8cff33;transition:.15s}
.cta:active{transform:scale(.98)}
.ghost{width:100%;padding:14px;border-radius:14px;background:#141c33;border:1px solid var(--bordo);
  color:var(--testo);font-weight:800;font-size:14px}
.riga{display:flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--bordo);
  border-radius:var(--r);padding:14px;margin-bottom:9px;transition:.15s;animation:sale .3s ease both}
.riga:active{transform:scale(.985)}
.riga .ic{width:44px;height:44px;border-radius:12px;background:#0d1425;border:1px solid var(--bordo);
  display:grid;place-items:center;font-size:20px;flex:none}
.riga .rc{flex:1;min-width:0}
.riga h3{font-size:15px;font-weight:800}
.riga p{font-size:12px;color:var(--muto);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.riga .fr{color:var(--muto);font-size:16px;flex:none}
.riga .btn{flex:none;padding:9px 15px;border-radius:11px;background:var(--grad);color:#04121c;font-weight:800;font-size:12.5px}
@keyframes sale{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.dato{display:flex;align-items:center;gap:12px;background:#0d1425;border:1px solid var(--bordo);
  border-radius:14px;padding:14px 16px}
.dato .barra{flex:1;height:8px;border-radius:4px;background:#1b2647;overflow:hidden}
.dato .barra i{display:block;height:100%;background:var(--grad);border-radius:4px;transition:width .6s ease}
.dato b{font-size:13px}
.dato small{color:var(--muto);font-size:11px;display:block}
.passi{display:flex;gap:6px;margin:4px 0 14px}
.passi i{flex:1;height:4px;border-radius:2px;background:#1b2647;transition:.3s}
.passi i.on{background:var(--grad)}
.avr{display:flex;gap:14px;overflow-x:auto;padding:6px 2px;scrollbar-width:none}
.avr::-webkit-scrollbar{display:none}
.avv{display:flex;flex-direction:column;align-items:center;gap:6px;flex:none;width:72px;transition:.15s;cursor:pointer}
.avv:active{transform:scale(.94)}
.avv .cerchio{width:62px;height:62px;border-radius:50%;background:#141c33;border:2px solid var(--bordo);
  display:grid;place-items:center;font-size:28px;transition:.2s}
.avv.on .cerchio{border-color:var(--acc);box-shadow:0 0 16px #5b8cff55}
.avv small{font-size:11px;color:var(--muto);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:72px}
.avv.on small{color:var(--acc2);font-weight:700}

/* dock dell'app (le schermate non-globo) */
.dockapp{position:fixed;left:0;right:0;bottom:0;z-index:100;background:#070b16ee;backdrop-filter:blur(16px);
  border-top:1px solid var(--bordo);display:flex;justify-content:space-around;padding:8px 0 12px}
.dockapp button{display:flex;flex-direction:column;align-items:center;gap:2px;font-size:10.5px;color:var(--muto);width:64px}
.dockapp button.on{color:var(--acc)}
.dockapp button span{font-size:20px}
.dockapp .cen{transform:translateY(-8px)}
.dockapp .cen span{width:48px;height:48px;border-radius:50%;background:var(--grad);color:#04121c;
  display:grid;place-items:center;font-size:26px;font-weight:900;box-shadow:0 6px 20px #5b8cff44}

/* ═════════ FOGLI / TENDA / POPUP con effetto vetro ═════════ */
.velo{position:fixed;inset:0;background:#00000088;z-index:400;opacity:0;pointer-events:none;transition:opacity .25s}
.velo.on{opacity:1;pointer-events:auto}
.fg{position:fixed;left:50%;transform:translate(-50%,105%);bottom:0;width:min(520px,100%);
  background:rgba(12,18,34,.62);border:1px solid rgba(255,255,255,.09);border-bottom:none;
  border-radius:22px 22px 0 0;z-index:410;max-height:82vh;display:flex;flex-direction:column;
  backdrop-filter:blur(26px) saturate(1.5);-webkit-backdrop-filter:blur(26px) saturate(1.5);
  box-shadow:0 -12px 50px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.07);
  transition:transform .32s cubic-bezier(.32,.72,.25,1)}
.fg.on{transform:translate(-50%,0)}
.fg .manico{width:44px;height:4px;border-radius:2px;background:var(--bordo);margin:10px auto 4px;flex:none}
.fg .ftesta{display:flex;align-items:center;gap:10px;padding:8px 18px 12px;border-bottom:1px solid var(--bordo);flex:none}
.fg .ftesta h2{font-size:16px;font-weight:900;flex:1}
.fg .fcorpo{overflow-y:auto;padding:14px 18px}
.fg .fpiedi{padding:12px 18px 20px;border-top:1px solid var(--bordo);flex:none}
.fg .riga{background:rgba(16,24,48,.45)}
.tenda{position:fixed;left:50%;transform:translate(-50%,-105%);top:0;width:min(520px,100%);
  background:rgba(12,18,34,.62);border:1px solid rgba(255,255,255,.09);border-top:none;
  border-radius:0 0 22px 22px;z-index:410;padding:18px 18px 16px;
  backdrop-filter:blur(26px) saturate(1.5);-webkit-backdrop-filter:blur(26px) saturate(1.5);
  transition:transform .32s cubic-bezier(.32,.72,.25,1)}
.tenda.on{transform:translate(-50%,0)}
.pop{position:fixed;left:50%;top:50%;transform:translate(-50%,-46%) scale(.94);opacity:0;pointer-events:none;
  width:min(460px,92%);background:rgba(12,18,34,.85);border:1px solid rgba(255,255,255,.09);border-radius:20px;z-index:410;
  backdrop-filter:blur(26px) saturate(1.5);-webkit-backdrop-filter:blur(26px) saturate(1.5);
  transition:.28s cubic-bezier(.32,.72,.25,1);padding:20px;max-height:86vh;overflow-y:auto}
.pop.on{opacity:1;pointer-events:auto;transform:translate(-50%,-50%) scale(1)}
.gruppo{margin-bottom:14px}
.gruppo .gt{font-size:10.5px;letter-spacing:.8px;text-transform:uppercase;color:var(--muto);font-weight:800;margin-bottom:6px}
.gvoce{display:flex;align-items:center;gap:12px;padding:13px 10px;border-radius:12px;font-size:14.5px;font-weight:600;width:100%;text-align:left}
.gvoce:active{background:#141c33}
.gvoce .gi{width:26px;text-align:center}
.gvoce .spunta{margin-left:auto;color:var(--verde)}
.gvoce.rossa{color:var(--rosso)}
.divisore{height:1px;background:var(--bordo);margin:6px 0}

/* barra di contesto (Sipario) usata nella Chat */
.ctx{flex:1;display:flex;align-items:center;gap:8px;background:#141c33;border:1px solid var(--bordo);
  border-radius:14px;padding:11px 14px;font-size:14px;font-weight:800;transition:.15s;min-width:0}
.ctx:active{transform:scale(.98)}
.ctx .det{color:var(--muto);font-weight:600;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ctx .freccia{margin-left:auto;color:var(--muto);transition:transform .25s;flex:none}
.ctx.aperto .freccia{transform:rotate(180deg)}

/* bolle chat */
.bolle{min-height:270px;display:flex;flex-direction:column;gap:10px;padding:12px 0}
.bolla{max-width:78%;padding:12px 15px;border-radius:18px;font-size:14.5px;line-height:1.45;animation:sale .3s ease both}
.bolla small{display:block;font-size:11px;color:var(--muto);margin-top:5px}
.bolla.mia{align-self:flex-end;background:#1d3a8a;border:1px solid #2a4aa5;border-bottom-right-radius:6px}
.bolla.sua{align-self:flex-start;background:var(--card2);border:1px solid var(--bordo);border-bottom-left-radius:6px}
.mic-zona{display:flex;justify-content:center;gap:18px;align-items:center;padding:14px 0 8px}
.mic{width:76px;height:76px;border-radius:50%;background:var(--grad);display:grid;place-items:center;
  font-size:32px;box-shadow:0 8px 28px #5b8cff44;border:none;transition:.15s}
.mic:active{transform:scale(.94)}
.mic-alone{position:relative}
.mic-alone::after{content:"";position:absolute;inset:-8px;border-radius:50%;border:2px solid #5b8cff44;animation:pulsa 2s infinite}
@keyframes pulsa{0%{transform:scale(.9);opacity:1}100%{transform:scale(1.25);opacity:0}}

/* schede life */
.lifenav{display:flex;gap:8px;overflow-x:auto;padding:2px 0 10px;scrollbar-width:none;position:sticky;top:66px;z-index:45;
  background:linear-gradient(var(--bg) 80%,transparent)}
.lifenav::-webkit-scrollbar{display:none}
.lifenav .pill{font-size:13.5px;padding:10px 16px}

/* ═════════ CSS DEL GLOBO (schermata Community) — scoperto sotto .pagina ═════════ */
#s-community, #radice{position:fixed;inset:0;background:#000}
.pagina{position:fixed;inset:0}
.globo{position:absolute;inset:0}
.velo-alto{position:absolute;left:0;right:0;top:0;height:180px;pointer-events:none;
  background:linear-gradient(#04070fd9 25%,transparent);z-index:5}
.velo-basso{position:absolute;left:0;right:0;bottom:0;height:220px;pointer-events:none;
  background:linear-gradient(transparent,#04070fe6 75%);z-index:5}
.pagina .testa{position:absolute;top:0;left:0;right:0;z-index:20;display:flex;align-items:center;gap:12px;
  padding:14px 16px}
.pagina .tq{background:#141c33cc;backdrop-filter:blur(8px)}
.pagina .tq.piu{background:var(--grad);color:#04121c;border:none;font-weight:900}
.pagina .testa h1{font-size:21px;font-weight:900;line-height:1.1}
.pagina .testa small{display:block;font-size:11.5px;color:var(--muto);font-weight:600}
.pagina .spinta{margin-left:auto;display:flex;gap:8px}
.pagina .tabs{position:absolute;top:66px;left:16px;right:16px;z-index:20;display:flex;gap:8px}
.pagina .tab{flex:1;text-align:center;padding:11px;border-radius:14px;background:#101830b3;color:var(--muto);
  font-weight:800;font-size:14px;border:1px solid var(--bordo);backdrop-filter:blur(8px);transition:.2s}
.pagina .tab.on{background:var(--grad);color:#04121c;border-color:transparent}
.pagina .cerca-fluttua{position:absolute;left:50%;transform:translateX(-50%);bottom:86px;z-index:25;
  width:min(520px,calc(100% - 32px));display:flex;gap:8px}
.pagina .cerca{flex:1;padding:15px 18px;border-radius:16px;border:1px solid var(--bordo);
  background:#0d1425d9;backdrop-filter:blur(14px);color:var(--testo);font-size:15px;outline:none;
  box-shadow:0 10px 40px #00000088;transition:border .2s;font-family:var(--font)}
.pagina .cerca:focus{border-color:var(--acc)}
.pagina .cerca::placeholder{color:#5b6688}
.pagina .scegli{flex:none;display:flex;align-items:center;gap:8px;padding:0 16px;border-radius:16px;
  background:#141c33d9;border:1px solid var(--bordo);backdrop-filter:blur(14px);
  font-size:14px;font-weight:800;box-shadow:0 10px 40px #00000088}
.pagina .scegli .fl{font-size:19px}
.pagina .tendina{position:absolute;left:50%;transform:translateX(-50%);bottom:150px;z-index:30;
  width:min(420px,calc(100% - 32px));max-height:46vh;background:rgba(12,18,34,.55);border:1px solid rgba(255,255,255,.09);
  border-radius:18px;backdrop-filter:blur(24px) saturate(1.5);-webkit-backdrop-filter:blur(24px) saturate(1.5);box-shadow:0 20px 60px #000c;
  display:flex;flex-direction:column;overflow:hidden;animation:sale .22s cubic-bezier(.32,.72,.25,1)}
.pagina .tendina .lista{overflow-y:auto}
.pagina .tendina .voce{display:flex;align-items:center;gap:11px;width:100%;text-align:left;
  padding:12px 16px;font-size:14px;font-weight:600;transition:.12s}
.pagina .tendina .voce:hover,.pagina .tendina .voce:active{background:#141c33}
.pagina .tendina .voce .fl{font-size:19px}
.pagina .tendina .voce .n{flex:1}
.pagina .tendina .voce .cnt{font-size:11px;color:var(--acc2);font-weight:800}
.pagina .foglio{position:absolute;left:50%;transform:translate(-50%,105%);bottom:0;z-index:40;
  width:min(560px,100%);max-height:56vh;
  background:rgba(12,18,34,.52);border:1px solid rgba(255,255,255,.09);border-bottom:none;
  border-radius:22px 22px 0 0;
  backdrop-filter:blur(26px) saturate(1.5);-webkit-backdrop-filter:blur(26px) saturate(1.5);
  box-shadow:0 -12px 50px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.07);
  display:flex;flex-direction:column;
  transition:transform .34s cubic-bezier(.32,.72,.25,1)}
.pagina .foglio.on{transform:translate(-50%,0)}
.pagina .foglio .manico{width:44px;height:4px;border-radius:2px;background:var(--bordo);margin:10px auto 2px;flex:none}
.pagina .foglio .ftesta{display:flex;align-items:center;gap:10px;padding:8px 18px 12px;border-bottom:1px solid var(--bordo)}
.pagina .foglio .ftesta .fl{font-size:26px}
.pagina .foglio .ftesta h2{font-size:16px;font-weight:900;flex:1;line-height:1.2}
.pagina .foglio .ftesta small{display:block;font-size:11px;color:var(--muto);font-weight:600}
.pagina .foglio .corpo{overflow-y:auto;padding:12px 16px 18px}
.pagina .riga{display:flex;align-items:center;gap:12px;background:rgba(16,24,48,.45);border:1px solid var(--bordo);
  border-radius:16px;padding:13px;margin-bottom:9px;animation:sale .3s ease both}
.pagina .riga .ic{width:42px;height:42px;border-radius:12px;background:#0d1425;border:1px solid var(--bordo);
  display:grid;place-items:center;font-size:19px;flex:none}
.pagina .riga .rc{flex:1;min-width:0}
.pagina .riga h3{font-size:14px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pagina .riga p{font-size:11.5px;color:var(--muto);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pagina .riga .btn,.pagina .btn{flex:none;padding:9px 15px;border-radius:11px;background:var(--grad);color:#04121c;font-weight:800;font-size:12.5px}
.pagina .btn.grande{padding:12px 22px;border-radius:12px}
.pagina .vuoto{text-align:center;color:var(--muto);padding:26px 10px;font-size:13px;line-height:1.6}
.pagina .dock{position:absolute;left:0;right:0;bottom:0;z-index:20;background:#04070fe6;backdrop-filter:blur(16px);
  border-top:1px solid var(--bordo);display:flex;justify-content:space-around;padding:8px 0 10px}
.pagina .dock button{display:flex;flex-direction:column;align-items:center;gap:2px;font-size:10.5px;color:var(--muto);width:64px}
.pagina .dock button.on{color:var(--acc)}
.pagina .dock button span{font-size:20px}
.pagina .dock .cen{transform:translateY(-8px)}
.pagina .dock .cen span{width:46px;height:46px;border-radius:50%;background:var(--grad);color:#04121c;
  display:grid;place-items:center;font-size:25px;font-weight:900;box-shadow:0 6px 20px #5b8cff44}
.terra-sw{position:absolute;top:120px;right:16px;z-index:20;display:flex;gap:4px;
  background:rgba(12,18,34,.55);border:1px solid rgba(255,255,255,.09);border-radius:99px;
  padding:4px;backdrop-filter:blur(14px)}
.terra-sw button{padding:7px 13px;border-radius:99px;font-size:12px;font-weight:800;color:var(--muto);transition:.2s}
.terra-sw button.on{background:var(--grad);color:#04121c}
.globe-landing-label{display:flex;flex-direction:column;align-items:center;gap:1px;
  background:rgba(0,0,0,.75);border:1px solid rgba(255,255,255,.15);border-radius:8px;
  padding:3px 8px;backdrop-filter:blur(4px);animation:sale .3s ease}
.globe-landing-code{font-size:11px;font-weight:800;letter-spacing:.12em;color:#fff}
.globe-landing-city{font-size:9px;color:#9aa4c0}

/* utility per i componenti copiati del globo */
.relative{position:relative}.absolute{position:absolute}
.w-full{width:100%}.h-full{height:100%}
.flex{display:flex}.flex-col{flex-direction:column}.items-center{align-items:center}
.justify-center{justify-content:center}
.gap-4{gap:1rem}.gap-1\.5{gap:.375rem}
.px-6{padding-left:1.5rem;padding-right:1.5rem}.py-4{padding-top:1rem;padding-bottom:1rem}
.px-3{padding-left:.75rem;padding-right:.75rem}.py-1\.5{padding-top:.375rem;padding-bottom:.375rem}
.ml-4{margin-left:1rem}.w-8{width:2rem}.h-8{height:2rem}.w-3{width:.75rem}.h-3{height:.75rem}
.rounded-full{border-radius:9999px}.rounded-2xl{border-radius:1rem}
.border{border-width:1px;border-style:solid}
.border-border\/30{border-color:rgba(35,48,82,.3)}
.border-border\/40{border-color:rgba(35,48,82,.4)}
.border-primary\/40{border-color:rgba(91,140,255,.4)}
.bg-background\/80{background-color:rgba(4,7,15,.8)}
.bg-background\/60{background-color:rgba(4,7,15,.6)}
.hover\:bg-background\/80:hover{background-color:rgba(4,7,15,.8)}
.bg-primary\/20{background-color:rgba(91,140,255,.2)}
.hover\:bg-muted\/20:hover{background-color:rgba(20,28,51,.4)}
.backdrop-blur-xl{backdrop-filter:blur(24px)}.backdrop-blur-md{backdrop-filter:blur(12px)}
.text-foreground{color:#eef2ff}.text-foreground\/70{color:rgba(238,242,255,.7)}
.hover\:text-foreground:hover{color:#eef2ff}
.text-muted-foreground{color:#8a94b8}.text-primary{color:#5b8cff}
.text-4xl{font-size:2.25rem;line-height:2.5rem}.text-lg{font-size:1.125rem}
.text-xs{font-size:.75rem}.font-medium{font-weight:500}
.uppercase{text-transform:uppercase}.tracking-wider{letter-spacing:.05em}
.z-10{z-index:10}.z-50{z-index:50}
.top-4{top:1rem}.bottom-4{bottom:1rem}.left-4{left:1rem}.bottom-8{bottom:2rem}
.left-1\/2{left:50%}
.-translate-x-1\/2{transform:translateX(-50%)}
.translate-y-0{--vy:0px}.translate-y-4{--vy:1rem}
.opacity-0{opacity:0}.opacity-100{opacity:1}
.transition-all{transition:all .2s}.duration-300{transition-duration:.3s}.duration-200{transition-duration:.2s}
.transition-colors{transition:color .2s,background-color .2s}
.shadow-lg{box-shadow:0 10px 15px -3px rgba(0,0,0,.4)}
.shadow-\[0_8px_32px_rgba\(0\,0\,0\,0\.3\)\]{box-shadow:0 8px 32px rgba(0,0,0,.3)}
.-translate-x-1\/2.translate-y-0{transform:translate(-50%,0)}
.-translate-x-1\/2.translate-y-4{transform:translate(-50%,1rem)}
@media(min-width:768px){.md\:left-8{left:2rem}.md\:translate-x-0.-translate-x-1\/2{transform:translate(0,0)}
.md\:translate-x-0.-translate-x-1\/2.translate-y-4{transform:translate(0,1rem)}}

/* desktop: la colonna resta leggibile (fix D8) */
@media(min-width:900px){.tel{max-width:560px}}
</style>
<style id="bartalk-adatta">
/* Adattato per l'innesto in BarTalk: il globo vive dentro la pagina Mondo,
   che porta gia la sua testata, la sua ricerca e il suo menu. Qui si toglie
   la chrome del file (testata, schede, ricerca, dock) e i tre pulsanti
   Notte/Giorno (sostituiti dall'icona unica di BarTalk): resta il pianeta. */
header.testa, .pagina .tabs, .cerca-fluttua, .dock, #dockapp { display:none !important; }
/* i tre pulsanti Notte/Giorno/Ibrido: fuori vista ma RENDERIZZATI, cosi
   l'icona unica di BarTalk puo cliccarli per cambiare il cielo. */
.terra-sw { opacity:0 !important; pointer-events:none !important; position:absolute !important; left:-9999px !important; top:0 !important; }
</style>
</head>
<body>
<div class="stelle"></div>

<!-- ═══════════════ HOME ═══════════════ -->
<!-- schermata demo s-home rimossa: il file vive dentro BarTalk, serve solo il pianeta -->

<!-- ═══════════════ CHAT (Sipario: contesto in alto, azioni in basso) ═══════════════ -->
<!-- schermata demo s-chat rimossa: il file vive dentro BarTalk, serve solo il pianeta -->

<!-- ═══════════════ COMMUNITY — IL GLOBO VERO ═══════════════ -->
<section class="schermo on" id="s-community">
  <div id="radice"></div>
<script>window.__TEXTURE_VERE={"earth-day.jpg":"data:image/jpeg;base64,","earth-night.jpg":"data:image/jpeg;base64,","earth-bump.png":"data:image/png;base64,","earth-specular.png":"data:image/png;base64,"};</script>
</section>

<!-- ═══════════════ LIFE ═══════════════ -->
<!-- schermata demo s-life rimossa: il file vive dentro BarTalk, serve solo il pianeta -->

<!-- ═══════════════ PROFILO ═══════════════ -->
<!-- schermata demo s-profilo rimossa: il file vive dentro BarTalk, serve solo il pianeta -->

<!-- ═══════════════ DOCK dell'app (nascosto sulla Community: il globo ha il suo) ═══════════════ -->
<nav class="dockapp" id="dockapp">
  <button id="dk-home" class="on" onclick="vai('home')"><span>🏠</span>Home</button>
  <button id="dk-chat" onclick="vai('chat')"><span>💬</span>Chat</button>
  <button class="cen" onclick="apri('fgCrea')"><span>+</span></button>
  <button id="dk-community" onclick="vai('community')"><span>🌐</span>Community</button>
  <button id="dk-profilo" onclick="vai('profilo')"><span>👤</span>Profilo</button>
</nav>

<!-- ═══════════════ VELO + FOGLI + TENDA + POPUP ═══════════════ -->
<div class="velo" id="velo" onclick="chiudiTutto()"></div>

<!-- foglio: stato -->
<div class="fg" id="fgStato">
  <div class="manico"></div>
  <div class="ftesta"><h2>Il tuo stato</h2><button class="tq" onclick="chiudiTutto()">✕</button></div>
  <div class="fcorpo">
    <div class="riga"><div class="ic">🇮🇹</div><div class="rc"><h3>Italiano</h3><p>Lingua che parli — tocca per cambiare</p></div><div class="fr">›</div></div>
    <div class="riga"><div class="ic">🔋</div><div class="rc"><h3>22 minuti di traduzione</h3><p>Il credito sta finendo</p></div><button class="btn">Ricarica</button></div>
    <div class="riga"><div class="ic">👋</div><div class="rc"><h3>Visitatore #570</h3><p>Accedi per conservare tutto</p></div><div class="fr">›</div></div>
  </div>
</div>

<!-- foglio: crea (bottone + del dock) -->
<div class="fg" id="fgCrea">
  <div class="manico"></div>
  <div class="ftesta"><h2>Crea</h2><button class="tq" onclick="chiudiTutto()">✕</button></div>
  <div class="fcorpo">
    <div class="riga" onclick="chiudiTutto();vai('chat')"><div class="ic">💬</div><div class="rc"><h3>Nuova conversazione</h3><p>QR, invito o gruppo</p></div><div class="fr">›</div></div>
    <div class="riga" onclick="chiudiTutto();vai('community')"><div class="ic">🌐</div><div class="rc"><h3>Nuovo BarTalk nel mondo</h3><p>Una stanza aperta sul pianeta</p></div><div class="fr">›</div></div>
    <div class="riga" onclick="chiudiTutto();vai('life');lifepById('podcast')"><div class="ic">🎙</div><div class="rc"><h3>Nuovo podcast</h3><p>I tuoi Compagni ne parlano</p></div><div class="fr">›</div></div>
    <div class="riga" onclick="chiudiTutto();vai('life');lifepById('obiettivi')"><div class="ic">🎯</div><div class="rc"><h3>Nuovo obiettivo</h3><p>Due passi, e i Compagni lo conoscono</p></div><div class="fr">›</div></div>
  </div>
</div>

<!-- foglio: modalità chat + tenda contesto -->
<div class="tenda" id="tendaChat">
  <span class="etic" style="margin-top:0">Modalità</span>
  <div class="seg">
    <button class="on">💬 Conversazione</button><button>🏫 Classroom</button>
    <button>🎉 Free Talk</button><button>⚡ Simultaneo</button>
  </div>
  <span class="etic">Lingue</span>
  <div style="display:flex;align-items:center;gap:12px">
    <div class="pill on" style="flex:1;text-align:center">🇮🇹 Italiano</div>
    <div class="tq" style="width:34px;height:34px">⇄</div>
    <div class="pill on" style="flex:1;text-align:center">🇺🇸 English (US)</div>
  </div>
  <span class="etic">Voce e motore</span>
  <div class="riga" style="margin-bottom:0"><div class="ic">🎙</div>
    <div class="rc"><h3>ElevenLabs · Carmelo La Rosa</h3><p>AI: GPT-4o Mini · tocca per cambiare</p></div><div class="fr">›</div></div>
  <div style="margin-top:16px"><button class="ghost" onclick="chiudiTutto()">Chiudi</button></div>
</div>

<!-- foglio: menu chat a gruppi -->
<div class="fg" id="fgMenuChat">
  <div class="manico"></div>
  <div class="ftesta"><h2>Luca · 🔋 22m</h2><button class="tq" onclick="chiudiTutto()">✕</button></div>
  <div class="fcorpo">
    <div class="gruppo"><div class="gt">Passa a</div>
      <button class="gvoce"><span class="gi">📞</span>Chiamata vocale</button>
      <button class="gvoce"><span class="gi">📹</span>Videochiamata</button>
      <button class="gvoce"><span class="gi">🚕</span>TaxiTalk</button>
    </div>
    <div class="divisore"></div>
    <div class="gruppo"><div class="gt">Durante la conversazione</div>
      <button class="gvoce"><span class="gi">💬</span>Sottotitoli<span class="spunta">✓</span></button>
      <button class="gvoce"><span class="gi">🎵</span>Abbassa la musica · 20%<span class="spunta">›</span></button>
    </div>
    <div class="divisore"></div>
    <div class="gruppo"><div class="gt">Alla fine</div>
      <button class="gvoce"><span class="gi">📋</span>Esporta conversazione</button>
      <button class="gvoce"><span class="gi">🧾</span>Rapporto tecnico</button>
      <button class="gvoce rossa"><span class="gi">🗄</span>Chiudi e archivia</button>
    </div>
  </div>
</div>

<!-- foglio: impostazioni corso -->
<div class="fg" id="fgCorso">
  <div class="manico"></div>
  <div class="ftesta"><h2>Impostazioni del corso</h2><button class="tq" onclick="chiudiTutto()">✕</button></div>
  <div class="fcorpo">
    <span class="etic" style="margin-top:0">Livello</span>
    <div class="seg"><button>👶 Bambino</button><button class="on">🌱 Base</button><button>📘 Medio</button><button>🎓 Uni</button></div>
    <span class="etic">Contenuti della lezione</span>
    <div class="seg"><button class="on">🎨 Disegni</button><button>🖼 Immagini</button><button>🔗 Link</button><button>🎬 Video</button></div>
    <span class="etic">Lingua</span>
    <div class="pillr"><div class="pill on">🇮🇹 Italiano</div><div class="pill">🇺🇸 English</div><div class="pill">🇪🇸 Español</div><div class="pill">🇫🇷 Français</div></div>
  </div>
  <div class="fpiedi"><button class="cta" onclick="chiudiTutto()">Fatto</button></div>
</div>

<!-- foglio: invita -->
<div class="fg" id="fgInvita">
  <div class="manico"></div>
  <div class="ftesta"><h2>Invita una persona</h2><button class="tq" onclick="chiudiTutto()">✕</button></div>
  <div class="fcorpo">
    <div class="riga"><div class="ic">🟢</div><div class="rc"><h3>WhatsApp</h3><p>Il link parte già tradotto nella sua lingua</p></div><div class="fr">›</div></div>
    <div class="riga"><div class="ic">✉️</div><div class="rc"><h3>Email</h3><p>Con le istruzioni per entrare</p></div><div class="fr">›</div></div>
    <div class="riga"><div class="ic">🔗</div><div class="rc"><h3>Copia il link</h3><p>Incollalo dove vuoi</p></div><div class="fr">›</div></div>
  </div>
</div>

<!-- foglio: demo -->
<div class="fg" id="fgDemo">
  <div class="manico"></div>
  <div class="ftesta"><h2>Sentila funzionare</h2><button class="tq" onclick="chiudiTutto()">✕</button></div>
  <div class="fcorpo">
    <div class="vuoto" style="padding:14px">Di' una frase in italiano:<br>la senti tornare in inglese, con una voce naturale.</div>
    <div class="mic-zona" style="padding-top:0"><div class="mic-alone"><button class="mic">🎤</button></div></div>
  </div>
</div>

<!-- foglio: tastiera chat -->
<div class="fg" id="fgTastiera">
  <div class="manico"></div>
  <div class="ftesta"><h2>Scrivi invece di parlare</h2><button class="tq" onclick="chiudiTutto()">✕</button></div>
  <div class="fcorpo">
    <textarea class="campo" placeholder="Scrivi qui: arriva tradotto…" autofocus></textarea>
  </div>
  <div class="fpiedi"><button class="cta" onclick="chiudiTutto()">Invia →</button></div>
</div>

<!-- foglio: i miglioramenti applicati -->
<div class="fg" id="fgInfo">
  <div class="manico"></div>
  <div class="ftesta"><h2>I miglioramenti in questa versione</h2><button class="tq" onclick="chiudiTutto()">✕</button></div>
  <div class="fcorpo" style="font-size:13px;line-height:1.7;color:var(--muto)">
    <b style="color:var(--testo)">Una sola grammatica, ovunque.</b><br>
    · Testata sempre uguale: ‹ · titolo · capsula di stato · azione<br>
    · Lo stato (lingua/credito/account) è UNA capsula, non oggetti sparsi<br>
    · Scelte brevi = segmenti · scelte lunghe = pill scorrevoli · mai griglie di card<br>
    · L'azione principale è UNA, fissa in basso, sempre uguale<br>
    · Le azioni salgono dal basso (fogli vetro), il contesto scende dall'alto (tenda)<br>
    · Menu ••• a gruppi, col distruttivo separato in fondo<br>
    · Avanzamento obiettivi = dato in sola lettura, mai uno slider<br>
    · Impara compatto: livello/contenuti/lingua nel foglio ⚙️<br>
    · Editor Compagno a sezioni, Salva sempre visibile<br>
    · Community = il pianeta vero (wueform, copia integrale) con 3 varianti Terra,<br>
      &nbsp;&nbsp;marker puntino con area di tocco piena, cerca sospeso sotto il mondo<br>
    · Desktop: colonna centrale leggibile, mai contenuti a tutta larghezza
  </div>
</div>

<!-- popup: editor Compagno a sezioni -->
<div class="pop" id="popCompagno">
  <div class="app-testa" style="padding:0 0 10px;position:static;background:none"><h1 style="font-size:18px">Elvis il Re</h1>
    <button class="tq" onclick="chiudiTutto()">✕</button></div>
  <div class="seg" id="segComp">
    <button class="on" onclick="compSez(0,this)">Chi è</button>
    <button onclick="compSez(1,this)">Carattere</button>
    <button onclick="compSez(2,this)">Voce e volto</button>
    <button onclick="compSez(3,this)">Mente</button>
  </div>
  <div style="min-height:230px;padding-top:14px">
    <div class="csez">
      <span class="etic" style="margin-top:0">Nome</span><input class="campo" value="Elvis il Re">
      <span class="etic">Ruolo</span><input class="campo" value="Icona musicale e culturale">
    </div>
    <div class="csez" style="display:none">
      <span class="etic" style="margin-top:0">Tono</span>
      <div class="seg"><button>Formale</button><button class="on">Vivo</button><button>Informale</button></div>
      <span class="etic">Calore</span>
      <div class="seg"><button>Distaccato</button><button>Neutro</button><button class="on">Caloroso</button></div>
      <span class="etic">Sintesi</span>
      <div class="seg"><button class="on">Conciso</button><button>Medio</button><button>Prolisso</button></div>
    </div>
    <div class="csez" style="display:none">
      <span class="etic" style="margin-top:0">Volto</span>
      <div class="avr"><div class="avv on"><div class="cerchio">🕺</div><small>attuale</small></div>
        <div class="avv"><div class="cerchio">✨</div><small>Genera</small></div>
        <div class="avv"><div class="cerchio">📤</div><small>Carica</small></div></div>
      <span class="etic">Voce</span>
      <div class="riga" style="margin:0"><div class="ic">🎙</div><div class="rc"><h3>Adam</h3><p>tocca per provare o cambiare</p></div><div class="fr">▶</div></div>
    </div>
    <div class="csez" style="display:none">
      <span class="etic" style="margin-top:0">Libertà</span>
      <div class="seg"><button>Preciso</button><button>Bilanciato</button><button class="on">Creativo</button></div>
      <span class="etic">Modello</span>
      <div class="seg"><button class="on">Veloce</button><button>Profondo</button></div>
      <span class="etic">Memoria</span>
      <div class="riga" style="margin:0"><div class="ic">🧠</div><div class="rc"><h3>Ti ricorda nel tempo</h3><p>spenta</p></div>
        <button class="pill">Accendi</button></div>
    </div>
  </div>
  <div style="margin-top:14px"><button class="cta" onclick="chiudiTutto()">✨ Salva</button></div>
</div>

<script>
/* ── navigazione fra schermate ── */
function vai(n){
  if(n==='crea'){ apri('fgCrea'); return; }
  chiudiTutto();
  document.querySelectorAll('.schermo').forEach(s=>s.classList.remove('on'));
  /* adattato per BarTalk: le schermate demo sono state rimosse, il
     ripiego e la community (il pianeta), e un id mancante non fa crollare */
  var s=document.getElementById('s-'+n) || document.getElementById('s-community');
  if(s) s.classList.add('on');
  if(n==='community') setTimeout(function(){window.dispatchEvent(new Event('resize'))},60);
  var dock=document.getElementById('dockapp');
  dock.style.display = (n==='community') ? 'none' : 'flex';
  ['home','chat','community','profilo'].forEach(function(k){
    var b=document.getElementById('dk-'+k); if(b) b.classList.toggle('on',k===n);
  });
  window.scrollTo(0,0);
}
window.__vai = vai; /* il globo (React) naviga da qui: dock e freccia ‹ */

/* ── sotto-pagine Life ── */
function lifep(p,btn){
  document.querySelectorAll('.lifepag').forEach(function(x){x.style.display='none'});
  document.getElementById('lp-'+p).style.display='block';
  document.querySelectorAll('.lifenav .pill').forEach(function(b){b.classList.remove('on')});
  if(btn) btn.classList.add('on');
}
function lifepById(p){
  var btns=document.querySelectorAll('.lifenav .pill');
  var ordine=['podcast','amico','tavola','impara','obiettivi','compagni'];
  lifep(p, btns[ordine.indexOf(p)]);
}

/* ── obiettivi: lista ⇄ form a 2 passi ── */
function obForm(apre){
  document.getElementById('obLista').style.display = apre?'none':'block';
  document.getElementById('obNuovo').style.display = apre?'block':'none';
  if(apre) obPasso(1);
}
function obPasso(n){
  document.getElementById('obPasso1').style.display = n===1?'block':'none';
  document.getElementById('obPasso2').style.display = n===2?'block':'none';
  document.getElementById('obp1').classList.add('on');
  document.getElementById('obp2').classList.toggle('on',n===2);
}

/* ── fogli / popup / tenda ── */
function apri(id){
  document.getElementById('velo').classList.add('on');
  var el=document.getElementById(id); el.classList.add('on');
  /* fix D7: il fuoco parte dal primo campo utile, mai dalla ✕ */
  setTimeout(function(){ var c=el.querySelector('input.campo,textarea.campo'); if(c) c.focus(); },340);
}
function chiudiTutto(){
  document.getElementById('velo').classList.remove('on');
  document.querySelectorAll('.fg,.pop,.tenda').forEach(function(f){f.classList.remove('on')});
  var c=document.getElementById('ctxChat'); if(c) c.classList.remove('aperto');
}
/* fix D5: Escape chiude SOLO l'ultimo livello (foglio aperto), non la pagina */
document.addEventListener('keydown',function(e){ if(e.key==='Escape') chiudiTutto(); });
function tenda(){
  var t=document.getElementById('tendaChat'), c=document.getElementById('ctxChat');
  if(t.classList.contains('on')){chiudiTutto();return}
  document.getElementById('velo').classList.add('on');
  t.classList.add('on'); c.classList.add('aperto');
}
function compSez(i,btn){
  document.querySelectorAll('#popCompagno .csez').forEach(function(s,ix){s.style.display=ix===i?'block':'none'});
  document.querySelectorAll('#segComp button').forEach(function(b){b.classList.remove('on')});
  btn.classList.add('on');
}
</script>

