uniform float uTime;
uniform sampler2D uSunTexture;
varying vec2 vUv;
varying vec3 vPos;

${W6}

void main() {
float n = snoise(vPos * 3.0 + uTime * 0.15);
n += 0.5 * snoise(vPos * 6.0 + uTime * 0.3);
n += 0.25 * snoise(vPos * 12.0 + uTime * 0.5);

vec4 texColor = texture2D(uSunTexture, vUv + n * 0.02);

vec3 hot = vec3(1.0, 0.95, 0.4);
vec3 cool = vec3(1.0, 0.3, 0.05);
vec3 plasma = mix(cool, hot, smoothstep(-0.3, 0.6, n));

vec3 finalColor = mix(texColor.rgb, plasma, 0.55);

float pulse = 1.0 + 0.08 * sin(uTime * 1.5);
finalColor *= pulse;

gl_FragColor = vec4(finalColor * 1.6, 1.0);
