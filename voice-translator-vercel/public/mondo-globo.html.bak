          vec3 giorno = dayColor.rgb;
          float lum = dot(giorno, vec3(0.299, 0.587, 0.114));
          giorno = mix(vec3(lum), giorno, 1.35);
          giorno = pow(giorno, vec3(1.15));
          giorno *= mix(0.88, 0.97, smoothstep(0.2, 0.6, lum));

          /* mare realistico: la maschera acqua (bianca sugli oceani) guida
