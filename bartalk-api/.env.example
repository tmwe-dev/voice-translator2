# URL del BarTalk Core esistente. Nessun codice del Core viene copiato qui.
BARTALK_CORE_URL=https://voice-translator2.vercel.app

# Segreto lungo e casuale (minimo 32 caratteri) usato per cifrare le API key.
BARTALK_API_SIGNING_SECRET=

# Durata massima di una API key emessa da /v1/auth/exchange.
BARTALK_API_KEY_TTL_DAYS=6

# Redis opzionale ma raccomandato: rende il rate limit per API key distribuito.
# Se omesso, il gateway usa un limite in memoria per istanza e il Core mantiene
# comunque i propri rate limit autorevoli.
API_REDIS_URL=
API_REDIS_TOKEN=
